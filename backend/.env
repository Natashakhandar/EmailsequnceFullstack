# Database - MySQL
# Using the Hostinger server name directly
DATABASE_URL="mysql://u825197931_email_user:Boost%402026@srv2205.hstgr.io:3306/u825197931_email_app"

# Server - Hostinger assigns PORT dynamically, but locally we use 3001 to match frontend proxy
PORT=3001
NODE_ENV=development

# SMTP Configuration (Outgoing)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_password_here

# IMAP Configuration (Incoming)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=your_email@example.com
IMAP_PASSWORD=your_password_here

# Email Settings
FROM_EMAIL=your_email@example.com
FROM_NAME="Your Company Name"
REPLY_TO_EMAIL=your_email@example.com
BOUNCE_EMAIL=your_email@example.com

# JWT Secret
# Replace with a strong, random string for JWT signing
JWT_SECRET=your-super-secret-jwt-key-here

# App URL (for unsubscribe links)
# Your production frontend URL
APP_URL=https://email.boostnow.in

# Superadmin Credentials (used by seed script)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_this_password
