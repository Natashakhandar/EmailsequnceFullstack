# Database - MySQL with basic pooling for Hostinger
DATABASE_URL="mysql://u825197931_email_user:BoostNow2026@srv2205.hstgr.io:3306/u825197931_email_app?connectionLimit=10&waitForConnections=true&enableKeepAlive=true&keepAliveInitialDelaySeconds=5"

# Prisma timeout (60 seconds for slow Hostinger connections)
PRISMA_QUERY_ENGINE_TIMEOUT_MS="60000"

# Server
PORT=3001
NODE_ENV="development"

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Settings
FROM_EMAIL=your-email@gmail.com
FROM_NAME="Your Company Name"
REPLY_TO_EMAIL=replies@yourcompany.com
BOUNCE_EMAIL=bounce@yourcompany.com

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here 

# App URL (for unsubscribe links)
APP_URL=http://localhost:3001
