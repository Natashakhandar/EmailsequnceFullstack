<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Standard Hostinger Node.js Proxy Rule
  # Try port 8080 which is common for Hostinger Node apps
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://localhost:8080/$1 [P,L]


</IfModule>
