<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Standard Hostinger Node.js Proxy Rule
  # Our port.txt confirmed the app is running on port 3001
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:3001/$1 [P,L]


</IfModule>
