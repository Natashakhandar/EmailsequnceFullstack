// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  signature String?  @db.Text // Email signature (supports HTML)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SMTP Settings (User-specific)
  smtpHost   String?
  smtpPort   Int?
  smtpSecure Boolean @default(true)
  smtpUser   String?
  smtpPass   String?
  fromEmail  String?
  fromName   String?
  
  // IMAP Settings (User-specific)
  imapHost   String?
  imapPort   Int?     @default(993)

  // Relations
  sequences Sequence[]
  contacts  Contact[]
  templates Template[]
  campaigns Campaign[]
  emailConfig EmailConfig?
  warmupSettings WarmupSettings?

  // Manager Relation
  managerId String?
  manager   User?   @relation("ManagerUsers", fields: [managerId], references: [id], onDelete: SetNull)
  managedUsers User[] @relation("ManagerUsers")

  @@map("users")
}

model WarmupSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  isEnabled        Boolean  @default(false)
  currentBatchSize Int      @default(10) // Starting limit
  dailyIncrement   Int      @default(5)  // Amount to increase each day
  maxLimit         Int      @default(200) // Maximum daily goal
  dailySentCount   Int      @default(0)   // Emails sent today
  lastSentDate     DateTime @default(now()) // To track daily resets
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("warmup_settings")
}

model Contact {
  id        String        @id @default(cuid())
  userId    String? // Owner of the contact/lead
  email     String
  firstName String?
  lastName  String?
  company   String?
  timezone  String        @default("UTC")
  status    ContactStatus @default(ACTIVE)
  leadListName String?    @map("lead_list_name")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  enrollments   Enrollment[]
  events        Event[]
  campaignLeads CampaignLead[]
  user          User?          @relation(fields: [userId], references: [id])

  @@unique([email, userId])
  @@map("contacts")
}

model Template {
  id        String   @id @default(cuid())
  userId    String?  // Owner of the template
  name      String
  subject   String
  body      String   @db.LongText // HTML or plain text - supports very long content
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sequenceSteps SequenceStep[]
  user          User?          @relation(fields: [userId], references: [id])

  @@map("templates")
}

model Sequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  userId      String? // Owner of the sequence (for signature purposes)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  steps       SequenceStep[]
  enrollments Enrollment[]
  trigger     SequenceTrigger?
  user        User?            @relation(fields: [userId], references: [id])
  campaigns   Campaign[]

  @@map("sequences")
}

model SequenceStep {
  id         String  @id @default(cuid())
  sequenceId String
  templateId String? // Made optional to support custom emails
  stepOrder  Int // 1, 2, 3, etc.
  delayDays  Int     @default(0) // Days to wait before sending this step
  delayHours Int     @default(0) // Additional hours to wait
  
  // NEW: Custom scheduling
  scheduleType  String  @default("delay") // "delay", "weekly", "monthly"
  dayOfWeek     Int?     // 0-6 (Sunday-Saturday)
  dayOfMonth    Int?     // 1-31

  // NEW: Trigger conditions and delay logic
  subject       String? // Email subject (can override template)
  body          String? @db.LongText // Email body (can override template) - supports very long content
  triggerType   String  @default("delay") // "delay", "opened", "not_opened", "replied", "skip"
  triggerStepId String? // Reference to step that triggers this one
  delayMinutes  Int     @default(0) // Additional minutes for precise timing

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sequence    Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template    Template?         @relation(fields: [templateId], references: [id]) // Made optional
  triggeredBy SequenceTrigger[]

  @@unique([sequenceId, stepOrder])
  @@map("sequence_steps")
}

model Enrollment {
  id           String           @id @default(cuid())
  contactId    String
  sequenceId   String
  campaignId   String? // Link enrollments to campaigns
  currentStep  Int              @default(1)
  lastSentStep Int? // Track the last step that was actually sent
  nextSendAt   DateTime?
  status       EnrollmentStatus @default(ACTIVE)
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequence Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  events   Event[]

  @@unique([contactId, sequenceId])
  @@map("enrollments")
}

model Event {
  id           String    @id @default(cuid())
  enrollmentId String
  contactId    String
  campaignId   String? // Link events to campaigns
  type         EventType
  details      String?   @db.MediumText // JSON string for additional data
  timestamp    DateTime  @default(now())
  emailId      String? // Message-ID from sent email

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@map("events")
}

model UnsubscribeToken {
  id        String    @id @default(cuid())
  token     String    @unique
  contactId String
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@map("unsubscribe_tokens")
}

model SequenceTrigger {
  id            String   @id @default(uuid())
  sequenceId    String   @unique
  triggerStepId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sequence    Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  triggerStep SequenceStep @relation(fields: [triggerStepId], references: [id], onDelete: Cascade)

  @@map("sequence_triggers")
}

model Campaign {
  id           String    @id @default(cuid())
  userId       String?   // Owner of the campaign
  campaignName String
  description  String?   @db.Text
  sequenceId   String
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  sequence      Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  campaignLeads CampaignLead[]
  enrollments   Enrollment[]
  events        Event[]
  user          User?          @relation(fields: [userId], references: [id])

  @@map("campaigns")
}

model CampaignLead {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  createdAt  DateTime @default(now())

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@map("campaign_leads")
}

// Enums
enum UserRole {
  USER
  ADMIN
  SUPERADMIN
  MANAGER
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
  UNSUBSCRIBED
}

enum EventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  FAILED
}

model EmailConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean  @default(false)
  smtpUser     String?
  smtpPassword String?
  fromEmail    String?
  fromName     String?

  imapHost     String?
  imapPort     Int?
  imapTls      Boolean  @default(true)
  imapUser     String?
  imapPassword String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}
