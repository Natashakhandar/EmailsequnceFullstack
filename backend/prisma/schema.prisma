// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  signature String?  @db.Text // Email signature (supports HTML)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sequences Sequence[]

  @@map("users")
}

model Contact {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String?
  lastName    String?
  company     String?
  timezone    String   @default("UTC")
  status      ContactStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  enrollments Enrollment[]
  events      Event[]

  @@map("contacts")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String   @db.LongText // HTML or plain text - supports very long content
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sequenceSteps SequenceStep[]

  @@map("templates")
}

model Sequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  userId      String?  // Owner of the sequence (for signature purposes)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  steps       SequenceStep[]
  enrollments Enrollment[]
  trigger     SequenceTrigger?
  user        User?    @relation(fields: [userId], references: [id])

  @@map("sequences")
}

model SequenceStep {
  id          String   @id @default(cuid())
  sequenceId  String
  templateId  String?  // Made optional to support custom emails
  stepOrder   Int      // 1, 2, 3, etc.
  delayDays   Int      @default(0) // Days to wait before sending this step
  delayHours  Int      @default(0) // Additional hours to wait
  
  // NEW: Trigger conditions and delay logic
  subject     String?  // Email subject (can override template)
  body        String?  @db.LongText // Email body (can override template) - supports very long content
  triggerType String   @default("delay") // "delay", "opened", "not_opened", "replied", "skip"
  triggerStepId String? // Reference to step that triggers this one
  delayMinutes Int     @default(0) // Additional minutes for precise timing
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template    Template? @relation(fields: [templateId], references: [id]) // Made optional
  triggeredBy SequenceTrigger[]

  @@unique([sequenceId, stepOrder])
  @@map("sequence_steps")
}

model Enrollment {
  id          String   @id @default(cuid())
  contactId   String
  sequenceId  String
  currentStep Int      @default(1)
  lastSentStep Int?    // Track the last step that was actually sent
  nextSendAt  DateTime?
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  events      Event[]

  @@unique([contactId, sequenceId])
  @@map("enrollments")
}

model Event {
  id           String    @id @default(cuid())
  enrollmentId String
  contactId    String
  type         EventType
  details      String?   // JSON string for additional data
  timestamp    DateTime  @default(now())
  emailId      String?   // Message-ID from sent email
  
  // Relations
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("events")
}

model UnsubscribeToken {
  id        String   @id @default(cuid())
  token     String   @unique
  contactId String
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@map("unsubscribe_tokens")
}

model SequenceTrigger {
  id            String   @id @default(uuid())
  sequenceId    String   @unique
  triggerStepId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sequence    Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  triggerStep SequenceStep @relation(fields: [triggerStepId], references: [id], onDelete: Cascade)

  @@map("sequence_triggers")
}

// Enums
enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
  UNSUBSCRIBED
}

enum EventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  FAILED
}
