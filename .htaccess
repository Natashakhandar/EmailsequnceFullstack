<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. DO NOT interfere with /api /health or /socket.io
  # Let Hostinger's Node.js handler take these
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^/health [NC,OR]
  RewriteCond %{REQUEST_URI} ^/socket.io [NC]
  RewriteRule ^ - [L]

  # 3. Serve static files if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route everything else to index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>
