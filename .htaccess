<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Allow Node.js to handle API and Socket.io
  # This prevents Apache from returning 404s for backend routes
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^/socket.io [NC]
  RewriteRule ^ - [L]

  # 3. Serve Frontend files if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route everything else to index.html (SPA routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Security: Disable directory browsing
Options -Indexes
