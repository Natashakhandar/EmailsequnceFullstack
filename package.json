{
    "name": "emailsequncefullstack",
    "version": "1.0.0",
    "description": "Root package to run both frontend and backend concurrently",
    "main": "index.js",
    "scripts": {
        "dev": "npm run install:all && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && npm run dev",
        "dev:frontend": "cd emailseq-frontend && npm run dev",
        "install:all": "cd backend && npm install && cd ../emailseq-frontend && npm install",
        "postinstall": "npx prisma generate --schema=./backend/prisma/schema.prisma",
        "start": "node index.js"
    },
    "dependencies": {
        "@prisma/client": "5.22.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "imap": "^0.8.19",
        "jsonwebtoken": "^9.0.2",
        "mailparser": "^3.7.5",
        "mysql2": "^3.11.5",
        "node-cron": "^3.0.3",
        "nodemailer": "^6.10.1",
        "socket.io": "^4.8.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "prisma": "5.22.0"
    }
}